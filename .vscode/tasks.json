{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake configure (debug-clang preset)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "debug-clang"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "cmake build (debug-clang preset)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "debug-clang",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "cmake configure (debug-clang preset)",
            "problemMatcher": "$gcc"
        },
        {
            "label": "ctest (debug-clang preset)",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--preset", "debug-clang"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
