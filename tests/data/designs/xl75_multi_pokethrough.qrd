<?xml version="1.0" encoding="utf-8"?>
<!-- FROZEN OFFENDER FIXTURE (Part-Placement Step 12 / T4). Same parts as xl75_multi.qrd, but with the
     whitepaper's edge-defined links instead of the corpus's recovered CM-to-CM links: the coupler nests
     only 0.04 m into the body bore, so its fore plane projects 0.04 m past the body rim into the solid
     nose, whose skin (0.0342 m at z=-0.26) is thinner than the coupler OD (0.0376 m). The Layer-2 sweep
     therefore reports a coupler-vs-nose poke-through (~0.0034 m at z=-0.26): solve.ok == false. This file
     keeps that diagnostic path exercised after the production xl75_multi.qrd was confirmed clean -- do NOT
     "fix" it. See PokeThroughRegressionTests / WorkedExampleTests. -->
<QtRocketDesign version="0.2">
  <design name=""/>
  <part type="NoseCone" name="MultiNose">
    <params baseRadius="0.0395" length="0.29999999999999999" wallThickness="0" density="1700" solid="true"/>
    <children>
      <part type="BodyTube" name="MultiBody">
        <params innerRadius="0.037600000000000001" outerRadius="0.0395" length="0.90000000000000002" density="1700"/>
        <link seat="Abut" parentStation="0" childStation="1" gap="0"/>
        <children>
          <part type="FinSet" name="MultiFins">
            <params density="1700" rootChord="0.10000000000000001" tipChord="0.040000000000000001" span="0.059999999999999998" sweep="0.040000000000000001" thickness="0.0030000000000000001" bodyRadius="0.0395" finCount="6"/>
            <link seat="OnSurface" parentStation="0.059999999999999998" childStation="0" gap="0"/>
            <children/>
          </part>
          <part type="BodyTube" name="MultiCoupler">
            <params innerRadius="0.035999999999999997" outerRadius="0.037600000000000001" length="0.080000000000000002" density="1700"/>
            <link seat="NestInBore" parentStation="1" childStation="0" gap="0.040000000000000001"/>
            <children/>
          </part>
        </children>
      </part>
    </children>
  </part>
  <motor commonName="M1350W"/>
  <sim dragCoefficient="1" referenceArea="0.001134" referenceAreaOverridden="false"/>
</QtRocketDesign>
