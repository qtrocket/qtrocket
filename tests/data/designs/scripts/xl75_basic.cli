# xl75_basic.qrd -- reference XL airframe: solid nose + body + 3 swept fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=BasicNose baseRadius=0.0395 length=0.3 density=1700
addpart BasicNose BodyTube name=BasicBody innerRadius=0.0376 outerRadius=0.0395 length=0.9 density=1700
addpart BasicBody FinSet name=BasicFins finCount=3 rootChord=0.14 tipChord=0.06 span=0.09 sweep=0.06 thickness=0.004 bodyRadius=0.0395 density=1700 seat=OnSurface parentStation=0 childStation=0
checkdesign
