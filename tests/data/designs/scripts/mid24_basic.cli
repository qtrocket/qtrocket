# mid24_basic.qrd -- reference mid airframe: solid nose + body + 3 swept fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=BasicNose baseRadius=0.013 length=0.09 density=900
addpart BasicNose BodyTube name=BasicBody innerRadius=0.0121 outerRadius=0.013 length=0.3 density=1000
addpart BasicBody FinSet name=BasicFins finCount=3 rootChord=0.05 tipChord=0.025 span=0.03 sweep=0.02 thickness=0.003 bodyRadius=0.013 density=900 seat=OnSurface parentStation=0 childStation=0
checkdesign
