# micro13_triangular.qrd -- triangular fins (tipChord = 0)
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=tri_nose baseRadius=0.0072 length=0.05 density=400
addpart tri_nose BodyTube name=tri_body innerRadius=0.0066 outerRadius=0.0072 length=0.18 density=400
addpart tri_body FinSet name=tri_fins finCount=3 rootChord=0.025 tipChord=0 span=0.02 sweep=0.012 thickness=0.0015 bodyRadius=0.0072 density=400 seat=OnSurface parentStation=0 childStation=0
checkdesign
