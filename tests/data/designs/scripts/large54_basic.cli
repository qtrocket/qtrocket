# large54_basic.qrd -- reference large airframe: solid nose + body + 3 swept fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=BasicNose baseRadius=0.0285 length=0.25 density=1500
addpart BasicNose BodyTube name=BasicBody innerRadius=0.0271 outerRadius=0.0285 length=0.6 density=1600
addpart BasicBody FinSet name=BasicFins finCount=3 rootChord=0.12 tipChord=0.06 span=0.06 sweep=0.04 thickness=0.004 bodyRadius=0.0285 density=1600 seat=OnSurface parentStation=0 childStation=0
checkdesign
