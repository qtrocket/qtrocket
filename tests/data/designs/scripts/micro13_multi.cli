# micro13_multi.qrd -- multi-child tree + baked-in motor: 6 fins + a flush bore coupler
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=multi_nose baseRadius=0.0072 length=0.05 density=400
addpart multi_nose BodyTube name=multi_body innerRadius=0.0066 outerRadius=0.0072 length=0.18 density=400
addpart multi_body FinSet name=multi_fins finCount=6 rootChord=0.018 tipChord=0.008 span=0.014 sweep=0.008 thickness=0.0012 bodyRadius=0.0072 density=400 seat=OnSurface parentStation=0 childStation=0
addpart multi_body BodyTube name=multi_coupler innerRadius=0.0058 outerRadius=0.0066 length=0.02 density=400 seat=NestInBore gap=0.02
setmotor 1/2A3
checkdesign
