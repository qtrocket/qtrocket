# large54_shell.qrd -- thin-shell nose + longer body + 4 fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=ShellNose baseRadius=0.0285 length=0.32 density=1500 solid=false wallThickness=0.003
addpart ShellNose BodyTube name=ShellBody innerRadius=0.0276 outerRadius=0.0285 length=0.75 density=1600
addpart ShellBody FinSet name=ShellFins finCount=4 rootChord=0.12 tipChord=0.06 span=0.08 sweep=0.06 thickness=0.004 bodyRadius=0.0285 density=1600 seat=OnSurface parentStation=0 childStation=0
checkdesign
