# micro13_shell.qrd -- thin-shell nose + longer body + 4 fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=shell_nose baseRadius=0.0072 length=0.07 density=400 solid=false wallThickness=0.001
addpart shell_nose BodyTube name=shell_body innerRadius=0.0068 outerRadius=0.0072 length=0.22 density=400
addpart shell_body FinSet name=shell_fins finCount=4 rootChord=0.028 tipChord=0.013 span=0.03 sweep=0.02 thickness=0.0015 bodyRadius=0.0072 density=400 seat=OnSurface parentStation=0 childStation=0
checkdesign
