# small18_basic.qrd -- reference small airframe: solid nose + body + 3 swept fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=BasicNose baseRadius=0.0098 length=0.1 density=700
addpart BasicNose BodyTube name=BasicBody innerRadius=0.0091 outerRadius=0.0098 length=0.25 density=700
addpart BasicBody FinSet name=BasicFins finCount=3 rootChord=0.04 tipChord=0.02 span=0.03 sweep=0.02 thickness=0.003 bodyRadius=0.0098 density=700 seat=OnSurface parentStation=0 childStation=0
checkdesign
