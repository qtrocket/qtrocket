# large38_shell.qrd -- thin-shell nose + longer body + 4 big fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=ShellNose baseRadius=0.02 length=0.16 density=1400 solid=false wallThickness=0.002
addpart ShellNose BodyTube name=LongAirframe innerRadius=0.0195 outerRadius=0.02 length=0.5 density=1400
addpart LongAirframe FinSet name=BigFins finCount=4 rootChord=0.07 tipChord=0.03 span=0.07 sweep=0.06 thickness=0.003 bodyRadius=0.02 density=1400 seat=OnSurface parentStation=0 childStation=0
checkdesign
