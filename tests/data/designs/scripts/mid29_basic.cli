# mid29_basic.qrd -- reference mid airframe: solid nose + body + 3 swept fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=Nose baseRadius=0.0155 length=0.15 density=2500
addpart Nose BodyTube name=Airframe innerRadius=0.0146 outerRadius=0.0155 length=0.4 density=2500
addpart Airframe FinSet name=Fins finCount=3 rootChord=0.08 tipChord=0.04 span=0.05 sweep=0.03 thickness=0.003 bodyRadius=0.0155 density=2500 seat=OnSurface parentStation=0 childStation=0
checkdesign
