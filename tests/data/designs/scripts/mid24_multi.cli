# mid24_multi.qrd -- multi-child tree + baked-in motor: 6 fins + a co-radial aft extension tube
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=MultiNose baseRadius=0.013 length=0.09 density=900
addpart MultiNose BodyTube name=MultiBody innerRadius=0.0121 outerRadius=0.013 length=0.3 density=1000
addpart MultiBody FinSet name=MultiFins finCount=6 rootChord=0.04 tipChord=0.02 span=0.025 sweep=0.015 thickness=0.0025 bodyRadius=0.013 density=900 seat=OnSurface parentStation=0 childStation=0
addpart MultiBody BodyTube name=MultiCoupler innerRadius=0.0121 outerRadius=0.013 length=0.04 density=1000
setmotor D12
checkdesign
