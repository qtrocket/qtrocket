# mid24_shell.qrd -- thin-shell nose + longer body + 4 fins
# Replayed by DesignRebuildTests and regenerate.sh; keep it runnable through
# `qtrocket-cli` with the motor fixtures preloaded (see regenerate.sh).
newdesign NoseCone name=ShellNose baseRadius=0.013 length=0.12 density=900 solid=false wallThickness=0.0015
addpart ShellNose BodyTube name=ShellBody innerRadius=0.0124 outerRadius=0.013 length=0.4 density=1000
addpart ShellBody FinSet name=ShellFins finCount=4 rootChord=0.06 tipChord=0.03 span=0.045 sweep=0.035 thickness=0.003 bodyRadius=0.013 density=900 seat=OnSurface parentStation=0 childStation=0
checkdesign
